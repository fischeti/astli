module m
  always_ff
    @(posedge clk_i or negedge rst_ni)
      begin : seq
        if (!rst_ni)
          q <= '0
        else
          q <= d
  always_comb
    begin
      var k: int
      y = 0
      for (int i = 0, int j = 1; (i < 4); i++, j--)
        y += i
      foreach (arr[a, b])
        arr[a][b] = 0
      case (sel)
        2'b00, 2'b01:
          y = 1
        default:
          ;
      while ((k < 3))
        k++
      do while ((k > 0))
        k--
      repeat (2)
        k = (k + 1)
  always
    @*
      y2 = |x
  always
    @(a iff en or posedge b)
      z = a
  initial
    fork : f
      label step
      #1
        ev_next = 1
      -> ev
      @(ev)
        ;
      wait (done)
        disable f
      wait fork
      x = #2 y
    join_none
  initial
    begin
      forever
        begin
          q <= repeat (2) @(posedge clk) d
          break
      force a = 1
      release a
      assert (a)
        ;
      else
        $error("a is %0d", a)
