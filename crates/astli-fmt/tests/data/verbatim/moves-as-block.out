// What no rule lays out keeps its lines, and they move with the first.
// A line that starts inside a token stays where it was.
module m;
  specify
    /* over
             lines */
    (a => b)
      = (1, 2);

      specparam s = "a \
  string";
// further left than the first line, which stops at the margin
  endspecify
endmodule
