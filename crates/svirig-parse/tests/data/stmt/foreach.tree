SOURCE_FILE
  PROCEDURAL_BLOCK
    LINE_COMMENT "// The brackets last in a `foreach` header name the loop's variables, any of"
    WHITESPACE "\n"
    LINE_COMMENT "// which may be left out; everything before them is the array, selects and all."
    WHITESPACE "\n"
    INITIAL_KW "initial"
    BLOCK
      WHITESPACE " "
      BEGIN_KW "begin"
      FOREACH_STMT
        WHITESPACE "\n  "
        FOREACH_KW "foreach"
        FOREACH_HEADER
          WHITESPACE " "
          L_PAREN "("
          FIELD_EXPR
            NAME_REF
              IDENT "cfg"
            DOT "."
            IDENT "words"
          L_BRACK "["
          IDENT "j"
          COMMA ","
          WHITESPACE " "
          IDENT "k"
          R_BRACK "]"
          R_PAREN ")"
        EXPR_STMT
          ASSIGNMENT
            NAME_REF
              WHITESPACE " "
              IDENT "x"
            WHITESPACE " "
            EQ "="
            LITERAL_EXPR
              WHITESPACE " "
              INT_LITERAL "1"
          SEMICOLON ";"
      FOREACH_STMT
        WHITESPACE "\n  "
        FOREACH_KW "foreach"
        FOREACH_HEADER
          WHITESPACE " "
          L_PAREN "("
          NAME_REF
            IDENT "banks"
          L_BRACK "["
          COMMA ","
          WHITESPACE " "
          IDENT "bank"
          R_BRACK "]"
          R_PAREN ")"
        EXPR_STMT
          ASSIGNMENT
            NAME_REF
              WHITESPACE " "
              IDENT "x"
            WHITESPACE " "
            EQ "="
            LITERAL_EXPR
              WHITESPACE " "
              INT_LITERAL "1"
          SEMICOLON ";"
      FOREACH_STMT
        WHITESPACE "\n  "
        FOREACH_KW "foreach"
        FOREACH_HEADER
          WHITESPACE " "
          L_PAREN "("
          INDEX_EXPR
            NAME_REF
              IDENT "seeds"
            L_BRACK "["
            CAST_EXPR
              NAME_REF
                BIT_KW "bit"
              APOSTROPHE "'"
              PAREN_EXPR
                L_PAREN "("
                NAME_REF
                  IDENT "part"
                R_PAREN ")"
            R_BRACK "]"
          L_BRACK "["
          IDENT "i"
          R_BRACK "]"
          R_PAREN ")"
        EXPR_STMT
          ASSIGNMENT
            NAME_REF
              WHITESPACE " "
              IDENT "x"
            WHITESPACE " "
            EQ "="
            LITERAL_EXPR
              WHITESPACE " "
              INT_LITERAL "1"
          SEMICOLON ";"
      WHITESPACE "\n"
      END_KW "end"
  WHITESPACE "\n"
