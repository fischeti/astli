  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    LINE_COMMENT "// 11.3.2 puts the unary operators above `**`, so this is `(-2) ** 2`, not"
    WHITESPACE "\n"
    LINE_COMMENT "// `-(2 ** 2)` as in most languages."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
