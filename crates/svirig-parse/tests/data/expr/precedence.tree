  CONTINUOUS_ASSIGN
    LINE_COMMENT "// Multiplication binds tighter than addition, the ordinary operators are"
    WHITESPACE "\n"
    LINE_COMMENT "// left-associative, and `**` is right-associative."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
