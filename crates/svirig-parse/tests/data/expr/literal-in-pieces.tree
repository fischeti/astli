SOURCE_FILE
  LINE_COMMENT "// 5.7.1 lets whitespace separate a size from its base and a base from its"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    LINE_COMMENT "// digits. Each of these is one LITERAL_EXPR, which is what stops a formatter"
    WHITESPACE "\n"
    LINE_COMMENT "// coming between the pieces."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "8"
        BASED_LITERAL "'hFF"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "8"
        WHITESPACE " "
        INT_BASE "'h"
        WHITESPACE " "
        IDENT "FF"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_BASE "'h"
        WHITESPACE " "
        IDENT "FF"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        UNBASED_UNSIZED_LITERAL "'0"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      BIN_EXPR
        LITERAL_EXPR
          WHITESPACE " "
          INT_LITERAL "8"
          WHITESPACE " "
          INT_BASE "'h"
          WHITESPACE " "
          IDENT "FF"
        WHITESPACE " "
        PLUS "+"
        LITERAL_EXPR
          WHITESPACE " "
          INT_LITERAL "1"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    LINE_COMMENT "// `4a43_f880` lexes as an integer and then an identifier. Nothing separates"
    WHITESPACE "\n"
    LINE_COMMENT "// them, which is what says they are one value."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "256"
        INT_BASE "'h"
        WHITESPACE " "
        INT_LITERAL "4"
        IDENT "a43_f880"
    SEMICOLON ";"
  WHITESPACE "\n"
