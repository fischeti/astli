SOURCE_FILE
  DIRECTIVE
    TICK_IDENT "`define"
    WHITESPACE " "
    IDENT "WIDTH"
    MACRO_BODY
      WHITESPACE " "
      INT_LITERAL "8"
  DIRECTIVE
    WHITESPACE "\n"
    TICK_IDENT "`define"
    WHITESPACE " "
    IDENT "GUARD"
  DIRECTIVE
    WHITESPACE "\n"
    LINE_COMMENT "// A body is text: the region in it belongs to wherever the macro is used, and"
    WHITESPACE "\n"
    LINE_COMMENT "// closes nothing here."
    WHITESPACE "\n"
    TICK_IDENT "`define"
    WHITESPACE " "
    IDENT "WRAP"
    L_PAREN "("
    IDENT "x"
    R_PAREN ")"
    MACRO_BODY
      WHITESPACE " "
      TICK_IDENT "`ifdef"
      WHITESPACE " "
      IDENT "E"
      WHITESPACE " "
      IDENT "x"
      WHITESPACE " "
      TICK_IDENT "`endif"
  DIRECTIVE
    WHITESPACE "\n"
    TICK_IDENT "`define"
    WHITESPACE " "
    IDENT "A"
    L_PAREN "("
    IDENT "x"
    R_PAREN ")"
    WHITESPACE " "
    LINE_CONTINUATION "\\\n"
    MACRO_BODY
      WHITESPACE "  "
      IDENT "do_thing"
      L_PAREN "("
      IDENT "x"
      R_PAREN ")"
      SEMICOLON ";"
      WHITESPACE " "
      LINE_CONTINUATION "\\\n"
      WHITESPACE "  "
      IDENT "do_other"
      L_PAREN "("
      IDENT "x"
      R_PAREN ")"
  WHITESPACE "\n"
