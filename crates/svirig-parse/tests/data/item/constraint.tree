SOURCE_FILE
  LINE_COMMENT "// A constraint ends at its brace rather than at a semicolon. Without the"
  CLASS_DECL
    WHITESPACE "\n"
    LINE_COMMENT "// rule, the fallback would carry on into the member after it."
    WHITESPACE "\n"
    CLASS_KW "class"
    WHITESPACE " "
    IDENT "C"
    SEMICOLON ";"
    CONSTRAINT_DECL
      WHITESPACE "\n  "
      CONSTRAINT_KW "constraint"
      WHITESPACE " "
      IDENT "c"
      VERBATIM
        WHITESPACE " "
        L_BRACE "{"
        WHITESPACE " "
        IDENT "a"
        WHITESPACE " "
        INSIDE_KW "inside"
        WHITESPACE " "
        L_BRACE "{"
        L_BRACK "["
        INT_LITERAL "0"
        COLON ":"
        INT_LITERAL "3"
        R_BRACK "]"
        R_BRACE "}"
        SEMICOLON ";"
        WHITESPACE " "
        R_BRACE "}"
    VAR_DECL
      TYPE_REF
        WHITESPACE "\n  "
        INT_KW "int"
      DECLARATOR
        WHITESPACE " "
        IDENT "x"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDCLASS_KW "endclass"
  CLASS_DECL
    WHITESPACE "\n"
    CLASS_KW "class"
    WHITESPACE " "
    IDENT "D"
    SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n  "
      EXTERN_KW "extern"
      WHITESPACE " "
      CONSTRAINT_KW "constraint"
      WHITESPACE " "
      IDENT "c"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDCLASS_KW "endclass"
  WHITESPACE "\n"
