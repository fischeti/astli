  PROGRAM_DECL
    WHITESPACE "\n"
    PROGRAM_KW "program"
    WHITESPACE " "
    IDENT "p"
    SEMICOLON ";"
    WHITESPACE "\n"
    ENDPROGRAM_KW "endprogram"
  PACKAGE_DECL
