  MODULE_DECL
    LINE_COMMENT "// A gate's or a switch's terminals are in order, outputs first, and its"
    WHITESPACE "\n"
    LINE_COMMENT "// instances may be unnamed or arrays. A gate may take a strength and a delay"
    WHITESPACE "\n"
    LINE_COMMENT "// of up to three values; a pull gate takes one strength."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "gates"
    PORT_LIST
      WHITESPACE " "
      L_PAREN "("
      PORT
        INPUT_KW "input"
