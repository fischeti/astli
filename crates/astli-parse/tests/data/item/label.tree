SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// A closing label belongs to the shell that wrote it."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "m"
    SEMICOLON ";"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
    WHITESPACE " "
    COLON ":"
    WHITESPACE " "
    IDENT "m"
  WHITESPACE "\n"
