SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// An import item is one package and one name or `*`: packages do not nest,"
    WHITESPACE "\n"
    LINE_COMMENT "// so `p::q::A` is kept as written, as is an item with no name."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "m"
    SEMICOLON ";"
    IMPORT_DECL
      WHITESPACE "\n  "
      IMPORT_KW "import"
      WHITESPACE " "
      IDENT "p"
      COLON_COLON "::"
      IDENT "A"
      COMMA ","
      WHITESPACE " "
      IDENT "q"
      COLON_COLON "::"
      STAR "*"
      SEMICOLON ";"
    IMPORT_DECL
      WHITESPACE "\n  "
      EXPORT_KW "export"
      WHITESPACE " "
      STAR "*"
      COLON_COLON "::"
      STAR "*"
      SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n  "
      IMPORT_KW "import"
      WHITESPACE " "
      IDENT "p"
      COLON_COLON "::"
      IDENT "q"
      COLON_COLON "::"
      IDENT "A"
      SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n  "
      IMPORT_KW "import"
      WHITESPACE " "
      IDENT "p"
      COLON_COLON "::"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  WHITESPACE "\n"
