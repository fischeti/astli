          QUESTION "?"
          R_PAREN ")"
        WHITESPACE " "
        UDP_SYMBOL "1"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        UDP_SYMBOL "1"
        SEMICOLON ";"
      UDP_ENTRY
        WHITESPACE "\n    "
        UDP_SYMBOL "r"
        WHITESPACE "    "
        UDP_SYMBOL "1"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        UDP_SYMBOL "1"
        SEMICOLON ";"
      UDP_ENTRY
        WHITESPACE "\n    "
        UDP_SYMBOL "n"
        WHITESPACE "    "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        MINUS "-"
        SEMICOLON ";"
      UDP_ENTRY
        WHITESPACE "\n    "
        QUESTION "?"
        WHITESPACE "    "
        STAR "*"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        MINUS "-"
        SEMICOLON ";"
      WHITESPACE "\n  "
      ENDTABLE_KW "endtable"
    WHITESPACE "\n"
    ENDPRIMITIVE_KW "endprimitive"
    WHITESPACE " "
    COLON ":"
    WHITESPACE " "
    IDENT "dff"
