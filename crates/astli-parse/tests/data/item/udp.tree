          WHITESPACE " "
          EQ "="
          LITERAL_EXPR
            WHITESPACE " "
            INT_LITERAL "1"
            BASED_LITERAL "'b0"
      COMMA ","
      PORT
        WHITESPACE " "
        INPUT_KW "input"
        DECLARATOR
          WHITESPACE " "
          IDENT "clk"
      COMMA ","
      PORT
        DECLARATOR
          WHITESPACE " "
          IDENT "d"
      R_PAREN ")"
    SEMICOLON ";"
    UDP_TABLE
      WHITESPACE "\n  "
      TABLE_KW "table"
      UDP_ENTRY
        UDP_EDGE
          WHITESPACE "\n    "
          L_PAREN "("
          UDP_SYMBOL "0"
          UDP_SYMBOL "1"
          R_PAREN ")"
        WHITESPACE " "
        UDP_SYMBOL "0"
        WHITESPACE " "
