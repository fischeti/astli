SOURCE_FILE
  UDP_DECL
    LINE_COMMENT "// A UDP's ports are declared in its header or after it, the output first. A"
    WHITESPACE "\n"
    LINE_COMMENT "// combinational one maps levels to an output; a sequential one maps its"
    WHITESPACE "\n"
    LINE_COMMENT "// inputs, one of which may change, and its state to the next state, `-` to"
    WHITESPACE "\n"
    LINE_COMMENT "// keep it. Symbols may be written together, `01`, and a directive stands"
    WHITESPACE "\n"
    LINE_COMMENT "// among the rows."
    WHITESPACE "\n"
    PRIMITIVE_KW "primitive"
    WHITESPACE " "
    IDENT "mux2"
    PORT_LIST
      WHITESPACE " "
      L_PAREN "("
      PORT
        DECLARATOR
          IDENT "y"
      COMMA ","
      PORT
        DECLARATOR
          WHITESPACE " "
          IDENT "s"
      COMMA ","
      PORT
        DECLARATOR
          WHITESPACE " "
          IDENT "a"
      COMMA ","
      PORT
        DECLARATOR
          WHITESPACE " "
          IDENT "b"
      R_PAREN ")"
    SEMICOLON ";"
    PORT_DECL
      WHITESPACE "\n  "
      OUTPUT_KW "output"
      DECLARATOR
        WHITESPACE " "
        IDENT "y"
      SEMICOLON ";"
    PORT_DECL
      WHITESPACE "\n  "
      INPUT_KW "input"
      DECLARATOR
        WHITESPACE " "
        IDENT "s"
      COMMA ","
      DECLARATOR
        WHITESPACE " "
        IDENT "a"
      COMMA ","
      DECLARATOR
        WHITESPACE " "
        IDENT "b"
      SEMICOLON ";"
    UDP_TABLE
      WHITESPACE "\n  "
      TABLE_KW "table"
      UDP_ENTRY
        WHITESPACE "\n  "
        LINE_COMMENT "// s a b : y"
        WHITESPACE "\n     "
        UDP_SYMBOL "0"
        WHITESPACE " "
        UDP_SYMBOL "1"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        UDP_SYMBOL "1"
        SEMICOLON ";"
      UDP_ENTRY
        WHITESPACE "\n     "
        UDP_SYMBOL "0"
        WHITESPACE " "
        UDP_SYMBOL "0"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        UDP_SYMBOL "0"
        SEMICOLON ";"
      UDP_ENTRY
        WHITESPACE "\n     "
        UDP_SYMBOL "1"
        WHITESPACE " "
        QUESTION "?"
        WHITESPACE " "
        UDP_SYMBOL "1"
        WHITESPACE " "
        COLON ":"
        WHITESPACE " "
        UDP_SYMBOL "1"
        SEMICOLON ";"
      UDP_ENTRY
        WHITESPACE "\n     "
        UDP_SYMBOL "1"
        QUESTION "?"
        UDP_SYMBOL "0"
        COLON ":"
        UDP_SYMBOL "0"
        SEMICOLON ";"
      CONDITIONAL_REGION
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`ifdef"
          WHITESPACE " "
          IDENT "PESSIMISTIC"
          UDP_ENTRY
            WHITESPACE "\n     "
            UDP_SYMBOL "x"
            WHITESPACE " "
            UDP_SYMBOL "1"
            WHITESPACE " "
            UDP_SYMBOL "1"
            WHITESPACE " "
            COLON ":"
            WHITESPACE " "
            UDP_SYMBOL "1"
            SEMICOLON ";"
        WHITESPACE "\n"
        TICK_IDENT "`endif"
      WHITESPACE "\n  "
      ENDTABLE_KW "endtable"
    WHITESPACE "\n"
    ENDPRIMITIVE_KW "endprimitive"
  UDP_DECL
    WHITESPACE "\n\n"
    PRIMITIVE_KW "primitive"
    WHITESPACE " "
    IDENT "dff"
    PORT_LIST
      WHITESPACE " "
