SOURCE_FILE
  PACKAGE_DECL
    LINE_COMMENT "// An unresolved macro can name the package in an import."
    WHITESPACE "\n"
    PACKAGE_KW "package"
    WHITESPACE " "
    IDENT "p"
    SEMICOLON ";"
    IMPORT_DECL
      WHITESPACE "\n    "
      IMPORT_KW "import"
      MACRO_CALL
        WHITESPACE " "
        TICK_IDENT "`OTHER_PKG"
      COLON_COLON "::"
      STAR "*"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDPACKAGE_KW "endpackage"
  WHITESPACE "\n"
