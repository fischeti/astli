SOURCE_FILE
  CLASS_DECL
    LINE_COMMENT "// A constraint ends at its brace rather than at a semicolon. Without the"
    WHITESPACE "\n"
    LINE_COMMENT "// rule, the fallback would carry on into the member after it."
    WHITESPACE "\n"
    CLASS_KW "class"
    WHITESPACE " "
    IDENT "C"
    SEMICOLON ";"
    CONSTRAINT_DECL
      WHITESPACE "\n  "
      CONSTRAINT_KW "constraint"
      WHITESPACE " "
      IDENT "c"
      CONSTRAINT_BLOCK
        WHITESPACE " "
        L_BRACE "{"
        CONSTRAINT_EXPR
          INSIDE_EXPR
            NAME_REF
              WHITESPACE " "
              IDENT "a"
            WHITESPACE " "
            INSIDE_KW "inside"
            RANGE_LIST
              WHITESPACE " "
              L_BRACE "{"
              L_BRACK "["
              LITERAL_EXPR
                INT_LITERAL "0"
              COLON ":"
              LITERAL_EXPR
                INT_LITERAL "3"
              R_BRACK "]"
              R_BRACE "}"
          SEMICOLON ";"
        WHITESPACE " "
        R_BRACE "}"
    VAR_DECL
      TYPE_REF
        WHITESPACE "\n  "
        INT_KW "int"
      DECLARATOR
        WHITESPACE " "
        IDENT "x"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDCLASS_KW "endclass"
  CLASS_DECL
    WHITESPACE "\n"
    CLASS_KW "class"
    WHITESPACE " "
    IDENT "D"
    SEMICOLON ";"
    CONSTRAINT_DECL
      WHITESPACE "\n  "
      EXTERN_KW "extern"
      WHITESPACE " "
      CONSTRAINT_KW "constraint"
      WHITESPACE " "
      IDENT "c"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDCLASS_KW "endclass"
  WHITESPACE "\n"
