  MODULE_DECL
    LINE_COMMENT "// A concurrent assertion checks a property, and a sequence is one. The"
    WHITESPACE "\n"
    LINE_COMMENT "// operators bind as the standard ranks them, from repetitions and `##` down"
    WHITESPACE "\n"
    LINE_COMMENT "// to `|->`, and the ones that take a whole property. A `(` holds a sequence"
    WHITESPACE "\n"
    LINE_COMMENT "// when one of their operators stands directly in it, and an expression"
    WHITESPACE "\n"
    LINE_COMMENT "// otherwise."
    WHITESPACE "\n"
