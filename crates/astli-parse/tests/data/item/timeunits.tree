SOURCE_FILE
  TIMEUNIT_DECL
    LINE_COMMENT "// Time units stand in a design unit's body, or ahead of any unit, and may"
    WHITESPACE "\n"
    LINE_COMMENT "// share a line or come from a macro."
    WHITESPACE "\n"
    TIMEUNIT_KW "timeunit"
    BIN_EXPR
      LITERAL_EXPR
        WHITESPACE " "
        TIME_LITERAL "1ns"
      WHITESPACE " "
      SLASH "/"
      LITERAL_EXPR
        WHITESPACE " "
        TIME_LITERAL "1ps"
    SEMICOLON ";"
  MODULE_DECL
    WHITESPACE "\n\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "m"
    SEMICOLON ";"
    TIMEUNIT_DECL
      WHITESPACE "\n  "
      TIMEUNIT_KW "timeunit"
      LITERAL_EXPR
        WHITESPACE " "
        TIME_LITERAL "1ns"
      SEMICOLON ";"
    TIMEUNIT_DECL
      WHITESPACE " "
      TIMEPRECISION_KW "timeprecision"
      LITERAL_EXPR
        WHITESPACE " "
        TIME_LITERAL "10ps"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  PACKAGE_DECL
    WHITESPACE "\n\n"
    PACKAGE_KW "package"
    WHITESPACE " "
    IDENT "p"
    SEMICOLON ";"
    TIMEUNIT_DECL
      WHITESPACE "\n  "
      TIMEUNIT_KW "timeunit"
      NAME_REF
        MACRO_CALL
          WHITESPACE " "
          TICK_IDENT "`UNIT"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDPACKAGE_KW "endpackage"
  WHITESPACE "\n"
