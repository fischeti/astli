SOURCE_FILE
  VERBATIM
    LINE_COMMENT "// A label left behind used to drag the next construct into the run, and then"
    WHITESPACE "\n"
    LINE_COMMENT "// the one after that."
    WHITESPACE "\n"
    CONSTRAINT_KW "constraint"
    WHITESPACE " "
    IDENT "C"
    COLON_COLON "::"
    IDENT "c"
    WHITESPACE " "
    L_BRACE "{"
    WHITESPACE " "
    IDENT "x"
    WHITESPACE " "
    EQ_EQ "=="
    WHITESPACE " "
    INT_LITERAL "1"
    SEMICOLON ";"
    WHITESPACE " "
    R_BRACE "}"
    WHITESPACE "\n"
    TASK_KW "task"
    WHITESPACE " "
    IDENT "C"
    COLON_COLON "::"
    IDENT "t"
    L_PAREN "("
    R_PAREN ")"
    SEMICOLON ";"
    WHITESPACE "\n  "
    IDENT "y"
    WHITESPACE " "
    EQ "="
    WHITESPACE " "
    INT_LITERAL "2"
    SEMICOLON ";"
    WHITESPACE "\n"
    ENDTASK_KW "endtask"
    WHITESPACE " "
    COLON ":"
    WHITESPACE " "
    IDENT "t"
  TASK_DECL
    WHITESPACE "\n"
    TASK_KW "task"
    WHITESPACE " "
    IDENT "C"
    COLON_COLON "::"
    IDENT "u"
    PORT_LIST
      L_PAREN "("
      R_PAREN ")"
    SEMICOLON ";"
    EXPR_STMT
      ASSIGNMENT
        NAME_REF
          WHITESPACE "\n  "
          IDENT "z"
        WHITESPACE " "
        EQ "="
        LITERAL_EXPR
          WHITESPACE " "
          INT_LITERAL "3"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDTASK_KW "endtask"
    WHITESPACE " "
    COLON ":"
    WHITESPACE " "
    IDENT "u"
  WHITESPACE "\n"
