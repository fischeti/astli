SOURCE_FILE
  PROCEDURAL_BLOCK
    LINE_COMMENT "// A statement no rule takes goes to the fallback, one statement at a time,"
    WHITESPACE "\n"
    LINE_COMMENT "// and the block around it still closes."
    WHITESPACE "\n"
    INITIAL_KW "initial"
    BLOCK
      WHITESPACE " "
      BEGIN_KW "begin"
      VERBATIM
        WHITESPACE "\n  "
        WAIT_ORDER_KW "wait_order"
        WHITESPACE " "
        L_PAREN "("
        IDENT "e1"
        COMMA ","
        WHITESPACE " "
        IDENT "e2"
        R_PAREN ")"
        SEMICOLON ";"
      EXPR_STMT
        ASSIGNMENT
          NAME_REF
            WHITESPACE "\n  "
            IDENT "x"
          WHITESPACE " "
          EQ "="
          LITERAL_EXPR
            WHITESPACE " "
            INT_LITERAL "3"
        SEMICOLON ";"
      WHITESPACE "\n"
      END_KW "end"
  WHITESPACE "\n"
