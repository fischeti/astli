SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// A construct no rule claims is a recovery, not a complaint. If this"
    WHITESPACE "\n"
    LINE_COMMENT "// reports, the parser is complaining about itself."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "top"
    SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n  "
      CHECKER_KW "checker"
      WHITESPACE " "
      IDENT "c"
      SEMICOLON ";"
      WHITESPACE " "
      ENDCHECKER_KW "endchecker"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  WHITESPACE "\n"
