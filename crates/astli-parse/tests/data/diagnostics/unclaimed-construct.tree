SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// A construct no rule claims, here a malformed one, is a recovery, not a"
    WHITESPACE "\n"
    LINE_COMMENT "// complaint. If this reports, the parser is complaining about itself."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "m"
    SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n  "
      PLUS "+"
      WHITESPACE " "
      IDENT "a"
      WHITESPACE " "
      IDENT "b"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  WHITESPACE "\n"
