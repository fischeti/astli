SOURCE_FILE
  VERBATIM
    LINE_COMMENT "// A construct no rule claims is a recovery, not a complaint. If this"
    WHITESPACE "\n"
    LINE_COMMENT "// reports, the parser is complaining about itself."
    WHITESPACE "\n"
    PRIMITIVE_KW "primitive"
    WHITESPACE " "
    IDENT "inv"
    WHITESPACE " "
    L_PAREN "("
    OUTPUT_KW "output"
    WHITESPACE " "
    IDENT "y"
    COMMA ","
    WHITESPACE " "
    INPUT_KW "input"
    WHITESPACE " "
    IDENT "a"
    R_PAREN ")"
    SEMICOLON ";"
    WHITESPACE "\n  "
    TABLE_KW "table"
    WHITESPACE " "
    INT_LITERAL "0"
    WHITESPACE " "
    COLON ":"
    WHITESPACE " "
    INT_LITERAL "1"
    SEMICOLON ";"
    WHITESPACE " "
    INT_LITERAL "1"
    WHITESPACE " "
    COLON ":"
    WHITESPACE " "
    INT_LITERAL "0"
    SEMICOLON ";"
    WHITESPACE " "
    ENDTABLE_KW "endtable"
    WHITESPACE "\n"
    ENDPRIMITIVE_KW "endprimitive"
  WHITESPACE "\n"
