SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// A construct no rule claims is a recovery, not a complaint. If this"
    WHITESPACE "\n"
    LINE_COMMENT "// reports, the parser is complaining about itself."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "top"
    SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n  "
      NETTYPE_KW "nettype"
      WHITESPACE " "
      REAL_KW "real"
      WHITESPACE " "
      IDENT "wire_t"
      WHITESPACE " "
      WITH_KW "with"
      WHITESPACE " "
      IDENT "resolver"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  WHITESPACE "\n"
