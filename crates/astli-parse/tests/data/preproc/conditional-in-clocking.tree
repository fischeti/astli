SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// A branch inside a clocking block holds what the block does: signals with"
    WHITESPACE "\n"
    LINE_COMMENT "// their skews, and declarations."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "m"
    SEMICOLON ";"
    CLOCKING_DECL
      WHITESPACE "\n  "
      CLOCKING_KW "clocking"
      WHITESPACE " "
      IDENT "cb"
      EVENT_CONTROL
        WHITESPACE " "
        AT "@"
        PAREN_EXPR
          L_PAREN "("
          POSEDGE_KW "posedge"
          NAME_REF
            WHITESPACE " "
            IDENT "clk"
          R_PAREN ")"
      SEMICOLON ";"
      CONDITIONAL_REGION
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`ifdef"
          WHITESPACE " "
          IDENT "X"
          CLOCKING_ITEM
            WHITESPACE "\n    "
            INPUT_KW "input"
            DELAY_CONTROL
              WHITESPACE " "
              HASH "#"
              LITERAL_EXPR
                INT_LITERAL "1"
            DECLARATOR
              WHITESPACE " "
              IDENT "b"
            SEMICOLON ";"
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`else"
          CLOCKING_ITEM
            WHITESPACE "\n    "
            OUTPUT_KW "output"
            WHITESPACE " "
            NEGEDGE_KW "negedge"
            DECLARATOR
              WHITESPACE " "
              IDENT "c"
            SEMICOLON ";"
          PROPERTY_DECL
            WHITESPACE "\n    "
            PROPERTY_KW "property"
            WHITESPACE " "
            IDENT "p"
            SEMICOLON ";"
            PROPERTY_SPEC
              PROPERTY_BIN_EXPR
                NAME_REF
                  WHITESPACE " "
                  IDENT "b"
                WHITESPACE " "
                PIPE_MINUS_GT "|->"
                NAME_REF
                  WHITESPACE " "
                  IDENT "c"
            SEMICOLON ";"
            WHITESPACE " "
            ENDPROPERTY_KW "endproperty"
        WHITESPACE "\n"
        TICK_IDENT "`endif"
      WHITESPACE "\n  "
      ENDCLOCKING_KW "endclocking"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  WHITESPACE "\n"
