      VIRTUAL_KW "virtual"
      WHITESPACE " "
      FUNCTION_KW "function"
      CONDITIONAL_REGION
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`ifdef"
          WHITESPACE " "
          IDENT "WIDE"
          CONDITIONAL_REGION
            CONDITIONAL_BRANCH
              WHITESPACE "\n"
              TICK_IDENT "`ifdef"
              WHITESPACE " "
