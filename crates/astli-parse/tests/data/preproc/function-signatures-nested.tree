              SUBROUTINE_SIGNATURE
                TYPE_REF
                  WHITESPACE "\n        "
                  VOID_KW "void"
                WHITESPACE " "
                IDENT "set_value"
                PORT_LIST
                  L_PAREN "("
                  PORT
                    TYPE_REF
                      LONGINT_KW "longint"
                    DECLARATOR
                      WHITESPACE " "
                      IDENT "value"
                  R_PAREN ")"
                SEMICOLON ";"
            CONDITIONAL_BRANCH
              WHITESPACE "\n"
              TICK_IDENT "`else"
              SUBROUTINE_SIGNATURE
                TYPE_REF
                  WHITESPACE "\n        "
                  VOID_KW "void"
                WHITESPACE " "
                IDENT "set_value"
                PORT_LIST
                  L_PAREN "("
                  PORT
                    TYPE_REF
                      LONGINT_KW "longint"
                      WHITESPACE " "
                      UNSIGNED_KW "unsigned"
                    DECLARATOR
                      WHITESPACE " "
                      IDENT "value"
                  R_PAREN ")"
                SEMICOLON ";"
            WHITESPACE "\n"
            TICK_IDENT "`endif"
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`else"
          SUBROUTINE_SIGNATURE
            TYPE_REF
              WHITESPACE "\n        "
              VOID_KW "void"
            WHITESPACE " "
            IDENT "set_value"
            PORT_LIST
              L_PAREN "("
              PORT
                TYPE_REF
                  INT_KW "int"
                DECLARATOR
                  WHITESPACE " "
                  IDENT "value"
              R_PAREN ")"
            SEMICOLON ";"
        WHITESPACE "\n"
        TICK_IDENT "`endif"
      EXPR_STMT
        ASSIGNMENT
          NAME_REF
