            LINE_COMMENT "// This body belongs to every signature."
            WHITESPACE "\n        "
            IDENT "count"
          WHITESPACE " "
          EQ "="
          NAME_REF
            WHITESPACE " "
            IDENT "value"
        SEMICOLON ";"
      WHITESPACE "\n    "
      ENDFUNCTION_KW "endfunction"
      WHITESPACE " "
