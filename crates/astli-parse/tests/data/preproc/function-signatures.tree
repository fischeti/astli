SOURCE_FILE
  CLASS_DECL
    LINE_COMMENT "// Alternative signatures share a function prefix and body."
    WHITESPACE "\n"
    CLASS_KW "class"
    WHITESPACE " "
    IDENT "c"
    SEMICOLON ";"
    FUNCTION_DECL
      WHITESPACE "\n    "
      VIRTUAL_KW "virtual"
      WHITESPACE " "
      FUNCTION_KW "function"
      CONDITIONAL_REGION
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`ifdef"
          WHITESPACE " "
          IDENT "WIDE"
          SUBROUTINE_SIGNATURE
            TYPE_REF
              WHITESPACE "\n    "
              VOID_KW "void"
            WHITESPACE " "
            IDENT "set_value"
            PORT_LIST
              L_PAREN "("
              PORT
                TYPE_REF
                  LONGINT_KW "longint"
                DECLARATOR
                  WHITESPACE " "
                  IDENT "value"
              R_PAREN ")"
            SEMICOLON ";"
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`else"
          SUBROUTINE_SIGNATURE
            TYPE_REF
              WHITESPACE "\n    "
              VOID_KW "void"
            WHITESPACE " "
            IDENT "set_value"
            PORT_LIST
              L_PAREN "("
              PORT
                TYPE_REF
                  INT_KW "int"
                DECLARATOR
                  WHITESPACE " "
                  IDENT "value"
              R_PAREN ")"
            SEMICOLON ";"
        WHITESPACE "\n"
        TICK_IDENT "`endif"
      WHITESPACE "\n    "
      ENDFUNCTION_KW "endfunction"
    WHITESPACE "\n"
    ENDCLASS_KW "endclass"
  WHITESPACE "\n"
