SOURCE_FILE
  CLASS_DECL
    LINE_COMMENT "// Alternative signatures share a function prefix and body."
    WHITESPACE "\n"
    CLASS_KW "class"
    WHITESPACE " "
    IDENT "c"
    SEMICOLON ";"
    VERBATIM
      WHITESPACE "\n    "
      VIRTUAL_KW "virtual"
      WHITESPACE " "
      FUNCTION_KW "function"
      CONDITIONAL_REGION
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`ifdef"
          WHITESPACE " "
          IDENT "WIDE"
          VERBATIM
            WHITESPACE "\n    "
            VOID_KW "void"
            WHITESPACE " "
            IDENT "set_value"
            L_PAREN "("
            LONGINT_KW "longint"
            WHITESPACE " "
            IDENT "value"
            R_PAREN ")"
            SEMICOLON ";"
        CONDITIONAL_BRANCH
          WHITESPACE "\n"
          TICK_IDENT "`else"
          VERBATIM
            WHITESPACE "\n    "
            VOID_KW "void"
            WHITESPACE " "
            IDENT "set_value"
            L_PAREN "("
            INT_KW "int"
            WHITESPACE " "
            IDENT "value"
            R_PAREN ")"
            SEMICOLON ";"
        WHITESPACE "\n"
        TICK_IDENT "`endif"
      WHITESPACE "\n    "
      ENDFUNCTION_KW "endfunction"
    WHITESPACE "\n"
    ENDCLASS_KW "endclass"
  WHITESPACE "\n"
