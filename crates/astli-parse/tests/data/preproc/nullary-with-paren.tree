SOURCE_FILE
  DIRECTIVE
    LINE_COMMENT "// `WITH stands in for a keyword, so the `(` opens an ordinary expression."
    WHITESPACE "\n"
    LINE_COMMENT "// The definition is what settles it."
    WHITESPACE "\n"
    TICK_IDENT "`define"
    WHITESPACE " "
    IDENT "WITH"
    MACRO_BODY
      WHITESPACE " "
      IFF_KW "iff"
  IMMEDIATE_ASSERTION
    WHITESPACE "\n"
    ASSERT_KW "assert"
    PAREN_EXPR
      WHITESPACE " "
      L_PAREN "("
      NAME_REF
        IDENT "a"
      R_PAREN ")"
    MACRO_CALL
      WHITESPACE " "
      TICK_IDENT "`WITH"
  VERBATIM
    WHITESPACE " "
    L_PAREN "("
    BANG "!"
    IDENT "b"
    R_PAREN ")"
    SEMICOLON ";"
  WHITESPACE "\n"
