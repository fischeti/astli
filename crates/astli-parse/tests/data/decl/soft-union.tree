SOURCE_FILE
  MODULE_DECL
    LINE_COMMENT "// SystemVerilog 2023: a packed union may be `soft`, its members of"
    WHITESPACE "\n"
    LINE_COMMENT "// different widths."
    WHITESPACE "\n"
    MODULE_KW "module"
    WHITESPACE " "
    IDENT "m"
    SEMICOLON ";"
    VAR_DECL
      UNION_TYPE
        WHITESPACE "\n  "
        UNION_KW "union"
        WHITESPACE " "
        SOFT_KW "soft"
        WHITESPACE " "
        L_BRACE "{"
        STRUCT_MEMBER
          TYPE_REF
            WHITESPACE "\n    "
            LOGIC_KW "logic"
            DIMENSION
              WHITESPACE " "
              L_BRACK "["
              LITERAL_EXPR
                INT_LITERAL "7"
              COLON ":"
              LITERAL_EXPR
                INT_LITERAL "0"
              R_BRACK "]"
          DECLARATOR
            WHITESPACE " "
            IDENT "a"
          SEMICOLON ";"
        STRUCT_MEMBER
          TYPE_REF
            WHITESPACE "\n    "
            LOGIC_KW "logic"
            DIMENSION
              WHITESPACE " "
              L_BRACK "["
              LITERAL_EXPR
                INT_LITERAL "5"
              COLON ":"
              LITERAL_EXPR
                INT_LITERAL "0"
              R_BRACK "]"
          DECLARATOR
            WHITESPACE " "
            IDENT "b"
          SEMICOLON ";"
        WHITESPACE "\n  "
        R_BRACE "}"
      DECLARATOR
        WHITESPACE " "
        IDENT "u"
      SEMICOLON ";"
    WHITESPACE "\n"
    ENDMODULE_KW "endmodule"
  WHITESPACE "\n"
