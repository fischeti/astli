      WHITESPACE " "
      IDENT "w"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "1"
        BASED_LITERAL "'b0"
    SEMICOLON ";"
  VAR_DECL
    WHITESPACE "\n"
    TRIREG_KW "trireg"
    STRENGTH
      WHITESPACE " "
      L_PAREN "("
      SMALL_KW "small"
      R_PAREN ")"
    DECLARATOR
      WHITESPACE " "
      IDENT "t"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    STRENGTH
      WHITESPACE " "
      L_PAREN "("
      WEAK0_KW "weak0"
      COMMA ","
      WHITESPACE " "
      PULL1_KW "pull1"
      R_PAREN ")"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "1"
        BASED_LITERAL "'b1"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
