SOURCE_FILE
  CONTINUOUS_ASSIGN
    LINE_COMMENT "// 5.7.1 lets whitespace separate a size from its base and a base from its"
    WHITESPACE "\n"
    LINE_COMMENT "// digits. Each of these is one LITERAL_EXPR, which is what stops a formatter"
    WHITESPACE "\n"
    LINE_COMMENT "// coming between the pieces."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "8"
        BASED_LITERAL "'hFF"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "8"
        WHITESPACE " "
        INT_BASE "'h"
        WHITESPACE " "
        IDENT "FF"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_BASE "'h"
        WHITESPACE " "
        IDENT "FF"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        UNBASED_UNSIZED_LITERAL "'0"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      BIN_EXPR
        LITERAL_EXPR
          WHITESPACE " "
          INT_LITERAL "8"
          WHITESPACE " "
          INT_BASE "'h"
          WHITESPACE " "
          IDENT "FF"
        WHITESPACE " "
        PLUS "+"
        LITERAL_EXPR
          WHITESPACE " "
          INT_LITERAL "1"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    LINE_COMMENT "// `4a43_f880` lexes as an integer and then an identifier. Nothing separates"
    WHITESPACE "\n"
    LINE_COMMENT "// them, which is what says they are one value."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "256"
        INT_BASE "'h"
        WHITESPACE " "
        INT_LITERAL "4"
        IDENT "a43_f880"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    LINE_COMMENT "// `?` is a `z` digit, and apart from its base it is a token of its own, here"
    WHITESPACE "\n"
    LINE_COMMENT "// and in the pieces after it; the `?` after the condition is not a digit."
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "2"
        INT_BASE "'b"
        WHITESPACE " "
        QUESTION "?"
        INT_LITERAL "1"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      LITERAL_EXPR
        WHITESPACE " "
        INT_LITERAL "4"
        INT_BASE "'b"
        WHITESPACE " "
        INT_LITERAL "1"
        QUESTION "?"
        INT_LITERAL "0"
        QUESTION "?"
    SEMICOLON ";"
  CONTINUOUS_ASSIGN
    WHITESPACE "\n"
    ASSIGN_KW "assign"
    ASSIGNMENT
      NAME_REF
        WHITESPACE " "
        IDENT "x"
      WHITESPACE " "
      EQ "="
      TERNARY_EXPR
        NAME_REF
          WHITESPACE " "
