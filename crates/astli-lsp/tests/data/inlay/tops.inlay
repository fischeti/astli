// A value is hinted only where every body of the definition around it
// agrees on it: at its defaults, and in each body the tops build. Here
// `top` builds `pair`, and so `unit`, with two widths.

module unit #(parameter int Width = 8) (input logic [Width-1:0] data_i);
  // Differs between the bodies: no hint.
  localparam int Twice = Width * 2;
  // The same in each: hinted.
  localparam int Lanes = 2 * 2 ‹= 4›;
endmodule

module pair #(parameter int Width = 8) ();
  logic [Width-1:0] data;
  // What the override gives `unit` depends on the body of `pair`, and its
  // port's type too.
  unit #(.Width(Width + 1)) u_unit (‹input› .data_i(data));
  unit #(.Width(4 + 4 ‹= 8›)) u_fixed (‹input logic [7:0]› .data_i(data[7:0]));
endmodule

module top;
  pair #(.Width(8)) u_narrow ();
  pair #(.Width(16)) u_wide ();
endmodule
